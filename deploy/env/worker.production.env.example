# Railway service: fleqo-worker   (config file: deploy/railway/worker.json)
# Template only — set real values in Railway's Variables tab. Never commit real values.
NODE_ENV=production
LOG_LEVEL=info
FLEQO_SERVICE=fleqo-worker

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_PREFIX=fleqo

# Must equal the API service's values (config validation and secret decryption).
BETTER_AUTH_URL=https://<your-web-domain>
WEB_ORIGINS=https://<your-web-domain>
BETTER_AUTH_SECRET=<same as api>
ENCRYPTION_KEY=<same as api>

WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
WORKER_CONCURRENCY=5
DISPATCH_POLL_MS=2000
RUN_LEASE_MS=60000

# Optional: expose GET /health for Railway health checks. Use the same port for both variables and set
# the service's healthcheck path to /health. Without these the worker runs fine; restartPolicy handles crashes.
# PORT=8080
# WORKER_HEALTH_PORT=8080
