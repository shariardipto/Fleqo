# Render Background Worker: fleqo-worker   (same repository and Dockerfile as the API; Docker Command: node dist/worker.js)
# Template only — set real values in the Render dashboard. Never commit real values. Guide: docs/deployment.md.
#
# Link the Environment Group "fleqo-shared" (NODE_ENV, LOG_LEVEL, QUEUE_PREFIX, DATABASE_URL, REDIS_URL,
# BETTER_AUTH_URL, WEB_ORIGINS, BETTER_AUTH_SECRET, ENCRYPTION_KEY, WORKFLOW_*; see api.production.env.example)
# and add only these:
FLEQO_SERVICE=fleqo-worker
WORKER_CONCURRENCY=5
DISPATCH_POLL_MS=2000
RUN_LEASE_MS=60000

# OAuth and email variables are API-only; leave them unset here.
# Render background workers receive no inbound traffic and are not health-checked, so WORKER_HEALTH_PORT
# is not needed. Watch the worker's logs instead (docs/deployment.md §5).
