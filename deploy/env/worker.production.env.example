# Railway service: fleqo-worker   (declared in .railway/railway.ts; this file mirrors its variables for the dashboard)
# Template only — set real values in Railway's Variables tab. Never commit real values.
NODE_ENV=production
LOG_LEVEL=info
FLEQO_SERVICE=fleqo-worker

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_PREFIX=fleqo

# The same project Shared Variables as the API (config validation and secret decryption must match).
BETTER_AUTH_URL=${{shared.BETTER_AUTH_URL}}
WEB_ORIGINS=${{shared.WEB_ORIGINS}}
BETTER_AUTH_SECRET=${{shared.BETTER_AUTH_SECRET}}
ENCRYPTION_KEY=${{shared.ENCRYPTION_KEY}}
# OAuth and email variables are API-only; leave them unset here.

WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
WORKER_CONCURRENCY=5
DISPATCH_POLL_MS=2000
RUN_LEASE_MS=60000

# Optional: expose GET /health for Railway health checks. Use the same port for both variables and set
# the service's healthcheck path to /health. Without these the worker runs fine; restartPolicy handles crashes.
# PORT=8080
# WORKER_HEALTH_PORT=8080
