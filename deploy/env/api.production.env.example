# Railway service: fleqo-api   (config file: deploy/railway/api.json)
# Template only — set real values in Railway's Variables tab. Never commit real values.
NODE_ENV=production
LOG_LEVEL=info
FLEQO_SERVICE=fleqo-api

# Railway references (recommended: private networking to the database/Redis services)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_PREFIX=fleqo

# Public web origin (Vercel). Browsers reach the API through the web app's /api proxy.
BETTER_AUTH_URL=https://<your-web-domain>
WEB_ORIGINS=https://<your-web-domain>

# Secrets: 32 random bytes, base64 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generate once per environment, store only in Railway, share the SAME values with the worker service.
BETTER_AUTH_SECRET=<generate>
ENCRYPTION_KEY=<generate>

# Requests arrive via Vercel (proxy) and Railway's edge: two proxies in front of Express.
TRUST_PROXY=2
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_WEBHOOK_PER_MIN=1200

# Social sign-in (optional; a provider is shown only when both values are set). See docs/social-auth.md.
# Register the redirect URI https://<your-web-domain>/api/auth/callback/<provider> with each provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

WEBHOOK_TOLERANCE_SECONDS=300
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
# PORT is injected by Railway.
