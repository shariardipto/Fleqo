# Railway service: fleqo-api   (declared in .railway/railway.ts; this file mirrors its variables for the dashboard)
# Template only — set real values in Railway's Variables tab. Never commit real values.
NODE_ENV=production
LOG_LEVEL=info
FLEQO_SERVICE=fleqo-api

# Railway references (recommended: private networking to the database/Redis services)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
QUEUE_PREFIX=fleqo

# Project-level Shared Variables (Project Settings -> Shared Variables), referenced by BOTH services:
#   BETTER_AUTH_URL / WEB_ORIGINS = public web origin (Vercel), e.g. https://app.example.com
#   BETTER_AUTH_SECRET / ENCRYPTION_KEY = 32 random bytes, base64 (seal them):
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=${{shared.BETTER_AUTH_URL}}
WEB_ORIGINS=${{shared.WEB_ORIGINS}}
BETTER_AUTH_SECRET=${{shared.BETTER_AUTH_SECRET}}
ENCRYPTION_KEY=${{shared.ENCRYPTION_KEY}}

# Requests arrive via Vercel (proxy) and Railway's edge: two proxies in front of Express.
TRUST_PROXY=2
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_WEBHOOK_PER_MIN=1200

# Social sign-in (optional; a provider is shown only when both values are set). See docs/social-auth.md.
# Register the redirect URI https://<your-web-domain>/api/auth/callback/<provider> with each provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Email verification + password reset (optional; see docs/email.md). Only `resend` is accepted in production.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Fleqo <no-reply@<your-verified-sending-domain>>
# RESEND_API_KEY=            (seal it)
# REQUIRE_EMAIL_VERIFICATION=true   (only after a test email has arrived)

WEBHOOK_TOLERANCE_SECONDS=300
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
# PORT is injected by Railway.
