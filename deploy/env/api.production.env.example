# Render Web Service: fleqo-api   (Docker; Dockerfile path apps/api/Dockerfile, built from the repository root)
# Template only — set real values in the Render dashboard. Never commit real values. Guide: docs/deployment.md.
#
# Variables in the first block are shared with the worker. Put them in one Render Environment Group
# (e.g. "fleqo-shared") and link it to both services, so the API and worker can never disagree.

# ── Environment Group "fleqo-shared" (API + worker) ─────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
QUEUE_PREFIX=fleqo
# Render Postgres "Internal Database URL" and Render Key Value "Internal Key Value URL" (same region as the services)
DATABASE_URL=<render-postgres-internal-url>
REDIS_URL=<render-key-value-internal-url>
# Public web origin (Vercel). Browsers reach the API through the web app's /api proxy.
BETTER_AUTH_URL=https://<your-web-domain>
WEB_ORIGINS=https://<your-web-domain>
# Secrets: 32 random bytes, base64 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=<generate>
ENCRYPTION_KEY=<generate>
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000

# ── fleqo-api only ──────────────────────────────────────────────────────────────────────────────
FLEQO_SERVICE=fleqo-api
# Vercel's proxy and Render's load balancer sit in front of Express. Start with 2 and confirm that the
# logged clientIp is your own address after deploying (docs/deployment.md §8).
TRUST_PROXY=2
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_WEBHOOK_PER_MIN=1200
WEBHOOK_TOLERANCE_SECONDS=300
# PORT is set by Render (default 10000); do not set it.

# Social sign-in (optional; a provider is shown only when both values are set). See docs/social-auth.md.
# Register the redirect URI https://<your-web-domain>/api/auth/callback/<provider> with each provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Email verification + password reset (optional; see docs/email.md). Only `resend` is accepted in production.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=Fleqo <no-reply@<your-verified-sending-domain>>
# RESEND_API_KEY=
# REQUIRE_EMAIL_VERIFICATION=true   (only after a test email has arrived)
