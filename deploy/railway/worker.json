{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": ["apps/api/**", "package-lock.json"]
  },
  "deploy": {
    "startCommand": "node dist/worker.js",
    "restartPolicyType": "ALWAYS",
    "drainingSeconds": 30
  }
}
