# $0 DEMO: Render Free Web Service "fleqo-demo" running the API AND the worker in one container.
#   Runtime Docker · Dockerfile Path apps/api/Dockerfile · Docker Command: node dist/single-service.js
#   Health Check Path /api/health · no Pre-Deploy Command (not available on Free; migrations run at start)
# Template only — set real values in the Render dashboard. Never commit real values. Guide: docs/deployment-demo.md.
# For production (separate API and worker services) use deploy/env/ and docs/deployment.md instead.

NODE_ENV=production
LOG_LEVEL=info

# Neon Free: the DIRECT connection string (Connection pooling OFF), exactly as Neon shows it, e.g.
#   postgresql://<role>:<password>@ep-<name>-<id>.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
# Prisma Migrate needs a direct connection; the app opens about 20 connections at most (Neon Free allows 97).
DATABASE_URL=<neon-direct-connection-string>

# Render Free Key Value in the SAME region, Maxmemory Policy = noeviction: its Internal Key Value URL.
REDIS_URL=<render-key-value-internal-url>
QUEUE_PREFIX=fleqo

# Public web origin (Vercel), e.g. https://fleqo-demo.vercel.app (no trailing slash).
BETTER_AUTH_URL=https://<your-project>.vercel.app
WEB_ORIGINS=https://<your-project>.vercel.app
# 32 random bytes, base64 — node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=<generate>
ENCRYPTION_KEY=<generate>

# Vercel's proxy + Render's load balancer; confirm with clientIp in the logs (docs/deployment.md §8).
TRUST_PROXY=2

# Sized for a 0.1-CPU instance (measured: docs/deployment-demo.md §6).
WORKER_CONCURRENCY=2
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
# Outbox safety net poll (events are normally queued immediately); 5 s instead of 2 s saves CPU.
DISPATCH_POLL_MS=5000
# On 0.1 CPU, sign-up (password hashing + several queries) can exceed Prisma's 5 s transaction default.
DB_TRANSACTION_TIMEOUT_MS=30000
DB_TRANSACTION_MAX_WAIT_MS=10000

# Migrations run at every start (a no-op when nothing is pending; safe with overlapping deploys).
# Set to false only if you run `npm run db:deploy` against Neon yourself before each deploy.
DEMO_MIGRATE_ON_START=true

# PORT is set by Render (10000); do not set it. Do not set WORKER_HEALTH_PORT.
# Optional: Google/GitHub sign-in and email, exactly as in deploy/env/api.production.env.example.
