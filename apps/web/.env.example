# Fleqo web (Next.js). Copy to apps/web/.env.local for local overrides.
# Where the Express API runs. The web app proxies /api/* to it (same-origin cookies).
# Local: http://localhost:4000   ·   Vercel: your Railway API URL, e.g. https://fleqo-api.up.railway.app
# Read at BUILD time (next.config.ts rewrites): rebuild/redeploy after changing it.
API_URL=http://localhost:4000

# Public origin of this website: canonical URLs, Open Graph images and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
