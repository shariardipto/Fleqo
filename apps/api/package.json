{
  "name": "api",
  "version": "1.0.0",
  "description": "Fleqo Express API and BullMQ worker",
  "main": "dist/server.js",
  "scripts": {
    "predev": "prisma generate",
    "dev": "cross-env NODE_ENV=development tsx watch src/server.ts",
    "predev:worker": "prisma generate",
    "dev:worker": "cross-env NODE_ENV=development tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "pretypecheck": "prisma generate",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "pretest": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:batch": "vitest run test/batch.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "predb:seed": "prisma generate",
    "db:seed": "tsx src/scripts/seed.ts",
    "smoke": "tsx src/scripts/smoke.ts",
    "db:studio": "prisma studio"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "supertest": "7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.14",
    "bullmq": "6.5.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.2",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "^7.10.1",
    "zod": "^4.6.7"
  }
}
