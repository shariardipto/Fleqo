# Fleqo API + worker environment. Copy to apps/api/.env and fill in local values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (matches compose.yaml + root .env credentials)
DATABASE_URL=postgresql://fleqo:change_me_locally@localhost:5432/fleqo?schema=public
# Redis for BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=fleqo

# Better Auth. BETTER_AUTH_URL is the public origin browsers use (the web app, which proxies /api).
BETTER_AUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Comma-separated browser origins allowed by CORS and Better Auth.
WEB_ORIGINS=http://localhost:3000

# 32 random bytes, base64. Encrypts connection signing secrets at rest. Generate like above.
ENCRYPTION_KEY=replace_with_32_bytes_base64

# Number of reverse proxies in front of the API (1 on Railway/most PaaS, 0 locally).
TRUST_PROXY=0
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_WEBHOOK_PER_MIN=1200

# Webhook replay window and workflow execution tuning
WEBHOOK_TOLERANCE_SECONDS=300
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
WORKER_CONCURRENCY=5
DISPATCH_POLL_MS=2000
RUN_LEASE_MS=60000

# Worker only: optional GET /health endpoint, and the service label in logs.
# WORKER_HEALTH_PORT=4100
# FLEQO_SERVICE=fleqo-worker

# Demo seed only (never in production): npm run db:seed
# SEED_DEMO_EMAIL=demo@fleqo.local
# SEED_DEMO_PASSWORD=choose-a-password

# Never set NODE_TLS_REJECT_UNAUTHORIZED=0: the API and worker refuse to start in production with it.
