# Fleqo API + worker environment. Copy to apps/api/.env and fill in local values.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# PostgreSQL (matches compose.yaml + root .env credentials)
DATABASE_URL=postgresql://fleqo:change_me_locally@localhost:5432/fleqo?schema=public
# Interactive-transaction limits; keep Prisma's defaults unless the CPU is tiny (0.1-vCPU demo: 30000 / 10000).
# DB_TRANSACTION_TIMEOUT_MS=5000
# DB_TRANSACTION_MAX_WAIT_MS=2000

# Redis for BullMQ
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=fleqo

# Better Auth. BETTER_AUTH_URL is the public origin browsers use (the web app, which proxies /api).
BETTER_AUTH_URL=http://localhost:3000
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace_with_at_least_32_random_characters
# Comma-separated browser origins allowed by CORS and Better Auth.
WEB_ORIGINS=http://localhost:3000

# 32 random bytes, base64. Encrypts connection signing secrets at rest. Generate like above.
ENCRYPTION_KEY=replace_with_32_bytes_base64

# Number of reverse proxies in front of the API (0 locally; production: see docs/deployment.md).
TRUST_PROXY=0
RATE_LIMIT_API_PER_MIN=600
RATE_LIMIT_WEBHOOK_PER_MIN=1200

# Webhook replay window and workflow execution tuning
WEBHOOK_TOLERANCE_SECONDS=300
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_BACKOFF_MS=2000
WORKER_CONCURRENCY=5
DISPATCH_POLL_MS=2000
RUN_LEASE_MS=60000

# Social sign-in (optional). A provider appears on the sign-in page only when BOTH values are set.
# Redirect URI to register with each provider: <BETTER_AUTH_URL>/api/auth/callback/<google|github|apple|twitter>
# Setup per provider: docs/authentication.md. Never commit real values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=            # Services ID, e.g. com.example.fleqo.web
# APPLE_CLIENT_SECRET=        # ES256 JWT signed with your Apple key (max 6 months; regenerate before expiry)
# APPLE_APP_BUNDLE_IDENTIFIER=
# TWITTER_CLIENT_ID=          # X OAuth 2.0 client (enable "Request email from users")
# TWITTER_CLIENT_SECRET=

# Email verification + password reset (optional; docs/authentication.md). Without EMAIL_PROVIDER no email is sent
# and "Forgot password?" is hidden. Locally, `log` prints each message and its link in the API console.
# EMAIL_PROVIDER=log          # log | file (tests) | resend (the only one allowed in production)
# EMAIL_FROM=Fleqo <no-reply@localhost>
# RESEND_API_KEY=
# EMAIL_FILE_DIR=tmp/emails   # for EMAIL_PROVIDER=file
# REQUIRE_EMAIL_VERIFICATION=false

# Worker only: optional GET /health endpoint, and the service label in logs.
# WORKER_HEALTH_PORT=4100
# FLEQO_SERVICE=fleqo-worker

# Demo seed only (never in production): npm run db:seed
# SEED_DEMO_EMAIL=demo@fleqo.local
# SEED_DEMO_PASSWORD=choose-a-password

# Never set NODE_TLS_REJECT_UNAUTHORIZED=0: the API and worker refuse to start in production with it.
